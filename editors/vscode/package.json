{
  "name": "modularjs",
  "displayName": "ModularJS",
  "description": "Coloration syntaxique des composants ModularJS (.mjs), complétion et aide au survol des 117 effets, des 200 alias que ModularJS livre et des effets de l'appli (fichiers *.effects.mjs), en français ou en anglais selon la langue de VS Code — script Civet, gabarit, table de routes (bloc <routes> et forme calculée @routes), types et valeurs permises (blocs <vars> et <types>), blocs theme et style en SASS (ou le langage de lang=\"…\", côté script comme côté style), symboles $ $$ § µ @.",
  "version": "1.16.0",
  "publisher": "rapturestudio",
  "license": "MIT",
  "categories": ["Programming Languages"],
  "keywords": ["modularjs", "mjs", "civet", "web components", "shadow dom"],
  "repository": { "type": "git", "url": "git+https://github.com/RaptureStudio42/modularjs-framework.git", "directory": "editors/vscode" },
  "homepage": "https://mjs.rapturestudio.fr",
  "engines": { "vscode": "^1.70.0" },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:modularjs"],
  "contributes": {
    "languages": [
      {
        "id": "modularjs",
        "aliases": ["ModularJS", "modularjs", "MJS"],
        "extensions": [".mjs", ".html.mjs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "modularjs",
        "scopeName": "text.html.modularjs",
        "path": "./syntaxes/modularjs.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.coffee": "coffeescript",
          "meta.embedded.block.ts":     "typescript",
          "meta.embedded.block.js":     "javascript",
          "meta.embedded.block.sass":   "sass",
          "meta.embedded.block.scss":   "scss",
          "meta.embedded.block.less":   "less",
          "meta.embedded.block.css":    "css"
        }
      }
    ]
  }
}
