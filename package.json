{
  "name": "modularjs-framework",
  "version": "3.1.0",
  "description": "ModularJS (MJS) — framework front compile-time : réactivité résolue à la compilation (sans Proxy au runtime), Custom Elements + Shadow DOM, syntaxe .mjs (Civet par défaut). Compilateur + runtime + CLI dev/HMR.",
  "license": "MIT",
  "author": "Matrix",
  "keywords": [
    "framework",
    "frontend",
    "reactive",
    "compiler",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "civet",
    "spa",
    "mjs",
    "modularjs"
  ],
  "homepage": "https://mjs.rapturestudio.fr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaptureStudio42/modularjs-framework.git"
  },
  "bugs": {
    "url": "https://github.com/RaptureStudio42/modularjs-framework/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/types/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./ws": {
      "types": "./dist/types/mjs-ws/index.d.ts",
      "import": "./dist/mjs-ws.js"
    },
    "./mjs-server": {
      "types": "./dist/types/mjs-server/index.d.ts",
      "import": "./dist/mjs-server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mjs": "bin/mjs"
  },
  "scripts": {
    "build:self": "rm -f dist/chunk-*.js && esbuild cli=src/cli.ts index=src/index.ts worker=src/bundler/worker.ts testing=src/testing/index.ts mjs-ws=src/mjs-ws/index.ts mjs-server=src/mjs-server/index.ts --bundle --splitting --platform=node --target=node20 --format=esm --packages=external --outdir=dist --chunk-names=chunk-[hash]",
    "build:types": "rm -rf dist/types && tsc -p tsconfig.types.json",
    "check:publish": "node --import tsx script/check-publish.ts",
    "typecheck": "tsc --noEmit",
    "test": "bash script/test-enclos.sh",
    "test:lies": "node --import tsx script/related-tests.ts",
    "test:brut": "mocha --recursive tests/ --extension ts --require tsx/esm --require ./tests/helpers/tmp-sweep.ts --exit",
    "test:browser": "mocha tests/browser-smoke/smoke.browser.mts tests/browser-smoke/transitions.browser.mts tests/browser-smoke/effets.browser.mts tests/browser-smoke/curseurs.browser.mts tests/browser-smoke/direct.browser.mts tests/browser-smoke/squelettes.browser.mts tests/browser-smoke/effets-visuels-rendu.browser.mts tests/browser-smoke/effets-visuels-ecran.browser.mts tests/browser-smoke/effets-grande-balise.browser.mts tests/browser-smoke/coeur-accessibilite.browser.mts --require tsx/esm --exit --timeout 600000",
    "lint": "eslint .",
    "bench:ws": "tsx bench/mjs-ws-bench.ts",
    "prepack": "npm run build:types",
    "prepublishOnly": "npm run build:self && npm run typecheck && npm run lint && npm run test:browser",
    "repetition": "bash script/repetition-publication.sh"
  },
  "files": [
    "dist",
    "src/runtime",
    "src/core-modules",
    "src/assets",
    "src/server/*.mjs",
    "bin",
    "docs",
    "!docs/img",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@danielx/civet": "^0.9.5",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "chokidar": "^5.0.0",
    "coffeescript": "^2.7.0",
    "esbuild": "^0.28.1",
    "magic-string": "^0.30.21",
    "sass": "^1.99.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "happy-dom": "^20.11.15",
    "mocha": "^11.7.6",
    "playwright": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@types/node": "*",
    "happy-dom": ">=20.11.2",
    "sharp": ">=0.33",
    "yaml": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
